# =============================================================================
# Clerk Environment Configuration
# =============================================================================

# Docker Compose execution mode:
# - CPU Mode (default):
COMPOSE_FILE=docker-compose.yaml

# - GPU Mode (NVIDIA CUDA acceleration - uncomment below and comment out CPU mode above):
# COMPOSE_FILE=docker-compose.yaml:docker-compose.gpu.yaml

# Container user/group permissions for volume mounts:
UID=1000
GID=1000
